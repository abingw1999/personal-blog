# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=xiaojuzi_blog
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 密钥（请修改为随机字符串）
JWT_SECRET=your-secret-key-change-this-in-production-must-be-at-least-256-bits-long

# 文件上传路径
FILE_UPLOAD_PATH=/app/uploads/
